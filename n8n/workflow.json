      "id": "4dc5d475-1613-423c-b3c8-7bc5b8c099b2",
      "name": "Sticky Note3"
    },
    {
      "parameters": {
        "jsCode": "const result = [];\n\n// Itera sobre todos os clientes que chegaram neste nó\nfor (const item of $input.all()) {\n  const cliente = item.json;\n  let mensagem_estatica = \"\";\n\n  // Cria a mensagem estática baseada nas regras do MVP\n  if (cliente.perfil === \"Conservador\") {\n    mensagem_estatica = `Olá, ${cliente.nome}! Notamos que seu perfil é Conservador. Para o seu saldo atual, nossa recomendação tem foco em renda fixa e segurança. Sugestão de investimento: ${$input.first().json.produto}.`;\n    \n  } else if (cliente.perfil === \"Moderado\") {\n    mensagem_estatica = `Olá, ${cliente.nome}! Sendo o seu perfil Moderado, o ideal para o seu saldo é buscar um mix equilibrado entre renda fixa e variável. Sugestão de investimento: ${$input.first().json.produto}.`;\n    \n  } else if (cliente.perfil === \"Arrojado\") {\n    mensagem_estatica = `Olá, ${cliente.nome}! Identificamos seu perfil Arrojado. Para potencializar seu saldo, recomendamos dar ênfase em ações buscando maior potencial de retorno. Sugestão de investimento: ${$input.first().json.produto}.`;\n  }\n\n  // Adiciona a mensagem gerada ao pacote de dados do cliente\n  result.push({\n    json: {\n      ...cliente,\n      mensagem_final: mensagem_estatica\n    }\n  });\n}\n\nreturn result;"
      },
