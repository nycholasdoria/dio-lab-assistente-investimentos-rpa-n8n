      "name": "busca_investimento"
    },
    {
      "parameters": {
        "jsCode": "// Substitua 'meu_csv' pelo nome do campo que contém o texto do ficheiro CSV vindo do nó anterior\nconst csvText = $input.first().json.investimentos; \n\n// Separa o texto em linhas e remove linhas vazias\nconst lines = csvText.split('\\n').filter(line => line.trim() !== '');\n\n// Extrai o cabeçalho (primeira linha) e separa pelas vírgulas\nconst headers = lines[0].split(',').map(header => header.trim());\n\nconst result = [];\n\n// Itera sobre as restantes linhas de dados\nfor (let i = 1; i < lines.length; i++) {\n    const currentLine = lines[i].split(',');\n    const obj = {};\n\n    // Mapeia cada valor para o seu respetivo cabeçalho\n    for (let j = 0; j < headers.length; j++) {\n        obj[headers[j]] = currentLine[j] ? currentLine[j].trim() : '';\n    }\n\n    // O n8n exige que a saída de dados esteja encapsulada na propriedade 'json'\n    result.push({ json: obj });\n}\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        -32
      ],
